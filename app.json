{
  "expo": {
    "name": "chins",
    "slug": "chins",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#021a16",
    "platforms": ["android", "ios"],
    "entryPoint": "./index.js",
    "splash": {
      "backgroundColor": "#021a16"
    },
    "android": {
      "package": "app.chins.social",
      "versionCode": 1,
      "backgroundColor": "#021a16",
      "adaptiveIcon": {
        "backgroundColor": "#054a43"
      }
    },
    "ios": {
      "bundleIdentifier": "app.chins.social",
      "buildNumber": "1",
      "backgroundColor": "#021a16",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Chins uses your microphone so you can send voice messages to Reed.",
        "NSCameraUsageDescription": "Chins uses your camera so you can add a profile photo.",
        "NSPhotoLibraryUsageDescription": "Chins uses your photo library so you can choose a profile photo."
      }
    },
    "extra": {
      "eas": {
        "projectId": "b90ccf39-af74-419b-871f-35fb072988a1"
      }
    }
  }
}
